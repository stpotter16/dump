# Copy to /etc/dump/dump.env on the target host.
# Owner root:dump, mode 640. Values are unquoted (EnvironmentFile has no
# reliable quote parsing).

DUMP_DB_PATH=/var/lib/dump
DUMP_SIMILARITY_THRESHOLD=0.5
PORT=8081

# Secrets
DUMP_SESSION_ENV_KEY=Output of make secrets/hmac
DUMP_PASSPHRASE=your-passphrase-here
VOYAGE_API_KEY=your-voyage-api-key
